{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "OATutor",
  "version": "0.1.0",
  "identifier": "io.oatutor.desktop",
  "build": {
    "frontendDist": "../build",
    "devUrl": "http://localhost:3001",
    "beforeDevCommand": "VITE_DESKTOP=true npm run dev",
    "beforeBuildCommand": "VITE_DESKTOP=true npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "OATutor",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "rpm"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
