{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "OATutor",
  "version": "0.1.0",
  "identifier": "io.oatutor.desktop",
  "build": {
    "frontendDist": "../desktop-vue/dist",
    "devUrl": "http://localhost:3002",
    "beforeDevCommand": "node src/tools/preprocessProblemPool.js && cd desktop-vue && pnpm dev",
    "beforeBuildCommand": "node src/tools/preprocessProblemPool.js && cd desktop-vue && pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "OATutor",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "rpm", "nsis", "msi"],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
