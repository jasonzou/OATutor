{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "OATutor Desktop",
  "version": "0.1.0",
  "identifier": "io.oatutor.vue",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:3002",
    "beforeDevCommand": "node ../src/tools/preprocessProblemPool.js && VITE_DESKTOP=true pnpm dev",
    "beforeBuildCommand": "node ../src/tools/preprocessProblemPool.js && VITE_DESKTOP=true pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "OATutor Desktop",
        "width": 1600,
        "height": 1000,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
